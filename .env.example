# ==============================================================================
# AREMA - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values for the provider you use.
# Every setting below maps to a field on arema.core.config.Settings; unset keys
# fall back to the defaults declared there. App settings are namespaced with the
# AREMA_ prefix; provider API keys stay un-prefixed (LiteLLM reads them by name).

# ==============================================================================
# LLM Provider Selection
# ==============================================================================
# Choose the active provider. Options:
#   google | openai | anthropic | ollama | lmstudio | openai_compatible | zai | xai

AREMA_LLM_PROVIDER=google

# ---- Google Gemini (required when AREMA_LLM_PROVIDER=google) ------------------
GOOGLE_API_KEY=your-google-api-key-here
AREMA_GOOGLE_MODEL=gemini-2.0-flash

# ---- OpenAI (required when AREMA_LLM_PROVIDER=openai) -------------------------
# OPENAI_API_KEY=your-openai-api-key-here
# AREMA_OPENAI_MODEL=gpt-4o
# AREMA_OPENAI_API_BASE=                     # Optional: Azure/OpenAI-proxy base URL

# ---- Anthropic Claude (required when AREMA_LLM_PROVIDER=anthropic) ------------
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# AREMA_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- Ollama (local; AREMA_LLM_PROVIDER=ollama) -------------------------------
# AREMA_OLLAMA_BASE_URL=http://localhost:11434
# AREMA_OLLAMA_MODEL=llama3.2

# ---- LM Studio (local; AREMA_LLM_PROVIDER=lmstudio) --------------------------
# AREMA_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# AREMA_LMSTUDIO_MODEL=local-model

# ---- OpenAI-compatible endpoint (vLLM, TGI, ...; AREMA_LLM_PROVIDER=openai_compatible)
# AREMA_OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPATIBLE_API_KEY=not-needed
# AREMA_OPENAI_COMPATIBLE_MODEL=default

# ---- Moonshot Kimi (OpenAI-compatible; AREMA_LLM_PROVIDER=openai_compatible) --
# The key takes no AREMA_ prefix -- that field is read from an explicit alias.
# OPENAI_COMPATIBLE_API_KEY=api-key-here
# AREMA_OPENAI_COMPATIBLE_BASE_URL=https://api.moonshot.ai/v1
# AREMA_OPENAI_COMPATIBLE_MODEL=kimi-k3

# ---- Z.AI / Zhipu GLM (required when AREMA_LLM_PROVIDER=zai) ------------------
# ZAI_API_KEY=your-zai-api-key-here
# AREMA_ZAI_MODEL=glm-4.5-flash
# AREMA_ZAI_API_BASE=https://api.z.ai/api/paas/v4

# ---- xAI / Grok (required when AREMA_LLM_PROVIDER=xai) ------------------------
# XAI_API_KEY=your-xai-api-key-here
# AREMA_XAI_MODEL=grok-4
# AREMA_XAI_API_BASE=https://api.x.ai/v1

# ==============================================================================
# Model Generation
# ==============================================================================
AREMA_AGENT_TEMPERATURE=0.7
# AREMA_AGENT_MAX_TOKENS=4096                # Optional: cap response length
# Malformed tool-call JSON (single quotes, trailing commas, Python literals) is
# auto-repaired by json_repair for every provider -- no flag needed. Works for
# all tools incl. external MCP tools.

# ==============================================================================
# Per-Agent Model Overrides (Optional)
# ==============================================================================
# Point any agent (keyed by its trace name) at a different model without code
# changes. Values are provider-agnostic via LiteLLM: either a fully qualified
# "provider/model" string or a bare model name resolved against AREMA_LLM_PROVIDER.
# Each is a JSON object env var; unset means every agent uses the default model.
#
# AREMA_AGENT_MODEL_OVERRIDES='{"smoke_agent": "anthropic/claude-sonnet-4-20250514"}'
# AREMA_AGENT_MODEL_MAX_TOKENS='{"smoke_agent": 8192}'
# AREMA_AGENT_MODEL_TEMPERATURE='{"smoke_agent": 0.3}'
#
# Per-agent reasoning effort (provider-neutral: minimal | low | medium | high).
# Empty (the default) leaves every agent in its provider's default mode -- nothing
# turns reasoning on unless set here. Effort-capable providers (OpenAI o-series,
# xAI, Anthropic) receive it as reasoning_effort; z.ai/GLM exposes only a binary
# thinking switch, so any level there enables thinking. Independent of the model
# override, so an agent on the default model can still opt in.
# AREMA_AGENT_REASONING_EFFORT='{"smoke_agent": "high"}'
#
# The deep agentic-recovery agents (dotnet_analyst, packer_analyst) drive multi-step
# IL reasoning + controlled in-sandbox unpacking; point them at a strong
# agentic-coding model regardless of the global provider, e.g.:
# AREMA_AGENT_MODEL_OVERRIDES='{"dotnet_analyst": "zai/glm-5.2", "packer_analyst": "zai/glm-5.2"}'
# GLM-5.2 runs non-reasoning unless thinking is enabled -- turn it on for those
# agents to get its multi-step reasoning (costs more tokens/latency; GLM
# rate-limits after ~26 rapid calls):
# AREMA_AGENT_REASONING_EFFORT='{"dotnet_analyst": "high", "packer_analyst": "high"}'

# ==============================================================================
# Token Usage & Cost Accounting (Optional)
# ==============================================================================
# Every run's final report appends a deterministic "Token Usage & Cost" section:
# one row per model (input / cached / output / thinking / total) plus an estimated
# USD cost. Costs come from a bundled price table (arema.runtime.token_pricing);
# a model with no entry renders its cost as "?" and is EXCLUDED from the total with
# an "(excludes N unpriced model(s): ...)" note -- a missing price never silently
# under-reports.
#
# Supply or override per-model rates with a JSON object keyed by model id. Each
# entry gives USD rates PER 1,000,000 TOKENS:
#   input  = uncached prompt tokens
#   cached = prompt-cache read tokens (typically ~0.1x input)
#   output = generated tokens; ALSO bills thinking/reasoning tokens
# The id is normalized before lookup: a provider prefix ("xai/grok-4") and a
# trailing bracket variant tag ("claude-opus-4-8[1m]") are stripped to the base id,
# so "grok-4" prices both "xai/grok-4" and "grok-4". Overrides merge over (and
# per model, replace) the bundled defaults. Rates below are PLACEHOLDERS -- set
# your provider's published per-1M prices.
#
# AREMA_MODEL_PRICE_OVERRIDES='{"grok-4": {"input": 0.0, "cached": 0.0, "output": 0.0}}'
#
# A model with no price is UNPRICED, never free. The usage report then shows the
# exact token counts and says the cost could not be calculated, rather than
# printing a $0.00 that reads as "this run cost nothing". If you route through
# openai_compatible the recorded id carries the "openai/" prefix whatever the
# real provider is, so price it under either form:
#   {"openai/kimi-k3": {"input": ..., "cached": ..., "output": ...}}

# ==============================================================================
# LLM Retry / Throttling
# ==============================================================================
AREMA_LLM_NUM_RETRIES=3
# AREMA_LLM_RETRY_MIN_WAIT=1.0               # Min backoff between retries (seconds)
# AREMA_LLM_RETRY_MAX_WAIT=60.0              # Max backoff between retries (seconds)
# AREMA_LLM_MIN_CALL_INTERVAL=0.0            # Min spacing between model calls (seconds)

# ==============================================================================
# Context Budget
# ==============================================================================
# Estimated-token ceiling for one run. Set it BELOW the model's real context
# limit so compaction fires before the model does. When even compaction cannot
# bring a run under this, the current stage stops cleanly with a checkpoint --
# which is what a stage sees when an earlier agentic stage has already spent the
# budget, so raise it if you routinely run multi-layer .NET or packed samples.
AREMA_CONTEXT_BUDGET_TOKENS=80000
# AREMA_CONTEXT_WARNING_RATIO=0.60           # Compaction begins at this occupancy
# AREMA_CONTEXT_HARD_RATIO=0.75              # Tighter preservation past this tier
# AREMA_CONTEXT_CRITICAL_RATIO=0.85          # Run stops cleanly above this tier
# AREMA_CONTEXT_MAX_LIST_ITEMS=30
# AREMA_CONTEXT_PRESERVE_RECENT_TOOLS=3
# AREMA_CONTEXT_PRESERVE_RECENT_MODEL_TURNS=4

# ==============================================================================
# Turn Limits
# ==============================================================================
AREMA_DEFAULT_TURN_LIMIT=100
# AREMA_AGENT_TURN_LIMITS='{"smoke_agent": 50}' # Optional per-agent overrides (JSON)

# ==============================================================================
# Logging
# ==============================================================================
AREMA_LOG_LEVEL=INFO
# AREMA_APP_NAME=arema                       # Optional: ADK app name for sessions

# ==============================================================================
# Working Memory
# ==============================================================================
# Backend-neutral structured storage. Default backend is SQLite on local disk;
# set AREMA_MEMORY_BACKEND=memory for ephemeral, in-process runs and tests.
AREMA_MEMORY_ENABLED=true
AREMA_MEMORY_BACKEND=sqlite
AREMA_MEMORY_PATH=~/.arema/memory/arema.db
# AREMA_MEMORY_RETRIEVAL_MAX_RECORDS=20
# AREMA_MEMORY_RETRIEVAL_TOKEN_LIMIT=4000

# ==============================================================================
# Sandbox Execution (optional; disabled by default)
# ==============================================================================
# When AREMA_SANDBOX_ENABLED=true, tools that need isolated execution claim a pod
# (or a local subprocess when no cluster is present). Backend 'auto' picks k8s
# when the client is importable + a cluster is reachable, else local.
# AREMA_SANDBOX_ENABLED=false
AREMA_SANDBOX_BACKEND=k8s
# AREMA_SANDBOX_NAMESPACE=agent-sandbox-demo
# AREMA_SANDBOX_DEFAULT_POOL=python-runtime-pool
# AREMA_SANDBOX_LOCAL_TUNNEL=true        # Kind/minikube/CI; false for a real cluster
# AREMA_SANDBOX_RUN_TIMEOUT=120     # Per-exec ceiling; raise (e.g. 300) for deep
#                                     unpack rounds (dnlib rewrite of a multi-MB
#                                     assembly + a mono run don't fit in 120s)
# AREMA_SANDBOX_CONNECT_TIMEOUT=30
# AREMA_SANDBOX_OUTPUT_CAP=65536
AREMA_SANDBOX_POOL_MAP={"radare2-mcp":"radare2-mcp-pool","ghidra-rpc":"ghidra-rpc-pool","deobfuscation-tools":"deobfuscation-tools-pool","ilspy-mcp":"ilspy-mcp-pool","jadx":"jadx-pool","analysis-workbench":"analysis-workbench-pool"}
# The SSE read timeout for MCP servers (e.g. r2mcp). Must accommodate the longest
# tool call — r2 `analyze` on a large binary can take minutes. Too short fires
# mid-analysis, the session drops, and r2mcp loses its open_file state.
# AREMA_MCP_READ_TIMEOUT=600.0

# ==============================================================================
# Hash-Reputation Enrichment (optional)
# ==============================================================================
# Asks third-party services what they already have on file about the sample's
# SHA-256, at intake, before any analysis runs. It answers what static analysis
# of one file cannot: whether the digest is a known distribution file, and
# whether it already carries a malware family name.
#
# These four settings map to reverse_engineering.intel.config.IntelSettings, not
# to arema.core.config.Settings -- the neutral core does not name a vendor.
#
# ---- ONLY THE DIGEST IS EVER SENT --------------------------------------------
# Never the file, never its name, never its path. A lookup asks whether a
# fingerprint has been seen. An upload would store the sample permanently,
# distribute it to the receiving service's antivirus partners, and make it
# downloadable by their premium customers, and it cannot be undone. AREMA has no
# upload path at all, not behind a flag.
#
# ---- LEAVE THESE EMPTY AND NOTHING IS QUERIED --------------------------------
# With no key set, no source runs -- including CIRCL hashlookup, which needs no
# credential of its own. Enrichment is off until you deliberately turn it on.
# Setting either key below switches it on, and hashlookup then runs alongside
# whichever keyed sources are configured.

# ---- CIRCL hashlookup (no key of its own) ------------------------------------
# ~6.4 billion hashes: NIST NSRL, Windows and Linux distribution packages,
# CDNJS, Snap, plus a known-malicious marker. Answers "is this a catalogued
# file". There is nothing to configure -- it runs whenever either key below is
# set, and not at all when neither is.

# ---- MalwareBazaar (abuse.ch; free key from https://auth.abuse.ch/) ----------
# The corpus is malware only, so a hit is a hit: it supplies the family name
# (Emotet, AgentTesla) that static analysis of a single file cannot produce.
# It is also the source that serves samples to any free key.
# Fair-use terms apply; see https://abuse.ch/terms-of-use/ .
# AREMA_MALWAREBAZAAR_API_KEY=your-malwarebazaar-auth-key-here

# ---- VirusTotal (key from https://www.virustotal.com/gui/my-apikey) ----------
# Broadest coverage: engine detection counts and a suggested threat label.
#
# READ BEFORE USING A FREE KEY. The free public API allows 4 requests per minute
# and 500 per day, which one request per run stays well inside. Its terms also
# state it "must not be used in commercial products or services" and "must not
# be used in business workflows that do not contribute new files". A hash-only
# workflow is exactly that second case, so a free key makes this a
# personal-research posture rather than something to run for clients. A premium
# key removes both constraints, and is also the only kind that can download.
# AREMA_VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# ---- Timeouts (optional; both have working defaults) -------------------------
# Per-source lookup ceiling. The sweep sits on the intake critical path between
# hashing the file and starting the pipeline, so a dead endpoint must cost a few
# seconds, never a stalled run. The whole sweep is capped at 15s.
AREMA_INTEL_TIMEOUT_SECONDS=5.0

# ---- THE SAME KEYS ALSO ENABLE FETCH-BY-HASH ---------------------------------
# With a key set you can ask for a sample you do not have:
#
#   "analyze the file 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
#
# Resolution order, and the first rule is absolute:
#   1. A PATH is never resolved externally. If you name a file and it is not
#      there, that is an error, not a reason to go looking on the internet.
#   2. A file named for the digest in the working directory (or a directory you
#      name), with or without a suffix, is used as-is with no network access.
#   3. Only then are the configured sources asked, BY DIGEST ALONE.
#
# What can actually serve bytes:
#   MalwareBazaar  - yes, on any free key.
#   VirusTotal     - premium keys only; a free key is refused with HTTP 403,
#                    reported as "this key cannot download", not as "not found".
#   hashlookup     - holds no samples; it answers questions about digests.
#
# Downloaded bytes are verified against the digest you asked for before being
# stored, so a source that serves something else is refused rather than analyzed.
#
# Transfer timeout in seconds, separate from the reputation timeout above
# because a download is a transfer rather than a question.
AREMA_FETCH_TIMEOUT_SECONDS=60.0
